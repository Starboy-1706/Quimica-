# ── Base de datos PostgreSQL (Supabase o local) ──────────────────────
# Desarrollo local:
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db
#
# Supabase → Project Settings → Database → Connection String.
# Se recomienda el Connection Pooler (puerto 6543) para la app:
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# El cliente habilita TLS automáticamente al detectar URLs de Supabase.

# ── Supabase Storage (SOLO server-side, nunca expuestas al navegador) ─
# Con estas claves el driver de archivos usa Supabase Storage (bucket
# privado + URLs firmadas). Sin prefijo NEXT_PUBLIC_ a propósito.
# SUPABASE_URL=https://<ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
# SUPABASE_STORAGE_BUCKET=materiales
#
# (Opcional, reservada para futuras fases de Auth en cliente:)
# NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key> esta SÍ es pública por diseño.

# ── Notificaciones por correo (Resend) ───────────────────────────────
# Sin RESEND_API_KEY el sistema opera en modo simulado (logs en consola).
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
# RESEND_FROM="Aula Docente <notificaciones@tudominio.edu>"

# ── URL pública del sitio (SEO, sitemap y enlaces en correos) ────────
# Es un dato público: el prefijo NEXT_PUBLIC_ es intencional y seguro aquí.
# NEXT_PUBLIC_SITE_URL=https://aula.tudominio.edu
